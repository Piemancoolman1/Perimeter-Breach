{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Perimeter Breach",
  "version": "0.1.0",
  "identifier": "com.piemancoolman.perimeterbreach",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Perimeter Breach",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "center": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Piemancoolman1/Perimeter-Breach/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY0MjExREQ1QTkwMDFDNTMKUldSVEhBQ3AxUjBoWkJJZUhheWRZNFBQdGJ2dXVnSXdiZ1djdC9CTURnVE8zMkFzcnRFVGg1bEUK"
    }
  }
}
